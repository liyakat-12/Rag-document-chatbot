# =============================================================================
# DocuMind AI — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# --- LLM Provider -----------------------------------------------------------
# openai | azure_openai | anthropic | extractive (offline / no API quota)
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.1

# Embeddings: local (free FastEmbed) | openai (paid)
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# 384 for BAAI/bge-small-en-v1.5; 1536 for text-embedding-3-small
EMBEDDING_DIMENSIONS=384

# OpenAI (when using openai providers)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Azure OpenAI (used when LLM_PROVIDER=azure_openai)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-20241022

# --- Application ------------------------------------------------------------
APP_NAME=DocuMind AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8501

# --- Uploads & Storage ------------------------------------------------------
UPLOAD_DIR=uploads
VECTOR_STORE_DIR=vector_store
MAX_UPLOAD_SIZE_MB=40
ALLOWED_EXTENSIONS=.pdf

# --- RAG / Chunking ---------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVER_TOP_K=4
# Dense (FAISS) weight in RRF; sparse (BM25) weight = 1 - HYBRID_SEARCH_WEIGHT
HYBRID_SEARCH_WEIGHT=0.5
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.95
TOKEN_BUDGET_PER_REQUEST=8000

# --- Database ---------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/chatbot.db

# --- Frontend ---------------------------------------------------------------
# Streamlit / optional Vite
API_BASE_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1
